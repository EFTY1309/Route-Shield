        <mxCell id="22" value="Sort by Duration — Fastest First" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1100" width="244" height="55" as="geometry" /></mxCell>
        <mxCell id="23" value="Deduplicate Routes&lt;br/&gt;Drop Near-Clones: Dual-ratio ≤ 8%&lt;br/&gt;(AND on Duration AND Distance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1210" width="244" height="70" as="geometry" /></mxCell>
        <mxCell id="24" value="Query MongoDB Crime Data ($near)&lt;br/&gt;500 m Radius per Route Segment&lt;br/&gt;2dsphere Index · Day / Night Filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1340" width="244" height="75" as="geometry" /></mxCell>
        <mxCell id="25" value="Apply Day / Night Crime Time Filter&lt;br/&gt;Matching time t_f = 2.0x  ·  Other t_f = 0.5x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1475" width="244" height="65" as="geometry" /></mxCell>
        <mxCell id="26" value="Compute 6-Factor Risk per Crime&lt;br/&gt;risk = d_f x s_f x t_f x w_type x w_concern x w_tol x 10&lt;br/&gt;(Haversine + Point-to-Segment Projection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1600" width="244" height="80" as="geometry" /></mxCell>
        <mxCell id="27" value="Blend 70% Severity + 30% Log-Density&lt;br/&gt;safetyScore = (100 - combinedRisk x 85 - 3 x N_highRisk) / 10&lt;br/&gt;Low 7.5+  ·  Medium 5.0+  ·  High below 5.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378" y="1745" width="244" height="80" as="geometry" /></mxCell>
